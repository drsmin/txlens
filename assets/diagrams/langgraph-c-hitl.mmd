	ingest --> pair_cancellations;
	llm_classify --> review;
	normalize --> rule_match;
	pair_cancellations --> normalize;
	review --> finalize;
	rule_match --> collect_targets;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
