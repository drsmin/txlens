# --- 비밀정보 (절대 커밋 금지) ---
.env
.env.*
!.env.example
*.key
*.pem
secrets.yaml
credentials.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node ---
node_modules/
npm-debug.log*
dist/
build/

# --- 프로젝트 산출물 ---
# ⚠️ 주의: .gitignore 에서 '#' 은 **줄 맨 앞에서만** 주석이다. 패턴 뒤에 주석을 붙이면
# 그 텍스트가 패턴에 포함되어 아무것도 매치하지 않는다 (실제로 겪었다 — 4.3MB 가 커밋될 참이었다).
# 그래서 설명은 항상 별도 줄에 쓴다. tests/test_gitignore.py 가 실제 무시 여부를 검사한다.

# LangGraph SqliteSaver checkpointer — 진행 중 HITL thread. 로컬 런타임 상태다.
state.db
*.sqlite
*.db-journal
.langgraph_api/

# 합성 데이터: 생성기 + 고정 시드로 재현한다 (python -m txlens.generator).
# 정답셋도 생성 시점에 함께 만들어지므로 재현 가능 — 커밋하지 않는다.
# `data/synthetic/` (디렉터리) 가 아니라 `/*` 다 — 디렉터리째 무시하면 아래 `!` 예외가 안 먹어
# 새 클론(제출 저장소)에서 .gitkeep 이 빠진다. 여기선 이미 추적 중이라 가려져 있었다.
data/synthetic/*
!data/synthetic/.gitkeep

# LLM 응답 캐시 — 재현 가능하고 용량이 크다.
.cache/

# 평가 하네스 출력물. 루트에 고정한다 — 앵커 없는 `reports/` 는 모든 깊이에 걸린다.
/reports/

# 커밋하는 것: data/gold/(표본 검수 결과)와 rules/(룰 사전 — 승격 이력이 쌓이는 자산).
# 둘은 손으로 만든 자산이라 재현이 불가하므로 반드시 push 되어 있어야 한다.

# 리포트 폰트 원본 — **빌드 입력이다.** 빌더가 이 파일을 pptx 안에 넣는다.
# 산출물(pptx)을 커밋하면서 그 입력을 빼면 재현이 외부 URL 에 걸린다. 그래서 커밋한다.
# 단 **쓰는 두 벌만** 추적한다 — OTF 는 cmap 이 다르고 서브셋은 완성형이 모자란다.
assets/fonts/*
!assets/fonts/README.md
!assets/fonts/NanumBarunGothic.ttf
!assets/fonts/NanumBarunGothicBold.ttf

# --- 도구 ---
.ipynb_checkpoints/
.streamlit/secrets.toml
.DS_Store
.idea/
.vscode/

# 평가 산출물 (재현 가능 — 커밋하지 않는다)
out/

# Office 임시 잠금 파일 (pptx/docx 를 열어둔 동안 생긴다)
~$*
